<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Two permissions, and only two:
         - RECORD_AUDIO: the microphone, used solely to record
           your loops on this device.
         - INTERNET: used for exactly one thing — on launch, one
           small request to GitHub asking whether a newer Woven
           Oak has been published (beta.10+). Nothing about you
           or your music is sent; no analytics, no telemetry, no
           other network use anywhere in the app. Deliberately NO
           ACCESS_NETWORK_STATE: the check does not need it, and
           offline it simply fails silent. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
