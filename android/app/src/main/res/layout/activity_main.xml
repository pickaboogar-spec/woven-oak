<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101018"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Woven Oak"
            android:textColor="#F2F2F7"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.1.0-beta.2 · free forever"
            android:textColor="#A7A7B8"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tap a pad to record · Hold a pad to clear it"
        android:textColor="#F2F2F7"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:minHeight="20dp"
        android:text=""
        android:textColor="#FFD479"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/pitchNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#F2F2F7"
            android:textSize="38sp"
            android:textStyle="bold" />

        <com.damonini.wovenoak.CentsMeterView
            android:id="@+id/centsMeter"
            android:layout_width="220dp"
            android:layout_height="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/pitchRange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Your range: —"
                android:textColor="#A7A7B8"
                android:textSize="13sp" />

            <Button
                android:id="@+id/flatsToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:backgroundTint="#2C2C3E"
                android:text="♯"
                android:textColor="#F2F2F7"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:alignmentMode="alignBounds"
        android:columnCount="2"
        android:rowCount="3">

        <Button
            android:id="@+id/pad1"
            style="@style/Pad"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#3D232B" />
        <Button
            android:id="@+id/pad2"
            style="@style/Pad"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#3D3123" />
        <Button
            android:id="@+id/pad3"
            style="@style/Pad"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#2E3D23" />
        <Button
            android:id="@+id/pad4"
            style="@style/Pad"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#23403D" />
        <Button
            android:id="@+id/pad5"
            style="@style/Pad"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#233149" />
        <Button
            android:id="@+id/pad6"
            style="@style/Pad"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#31233D" />
    </GridLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/playAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:backgroundTint="#274435"
            android:padding="14dp"
            android:text="▶  Play all"
            android:textColor="#F2F2F7"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/stopAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:backgroundTint="#2C2C3E"
            android:padding="14dp"
            android:text="■  Stop all"
            android:textColor="#F2F2F7"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Play together — tap numbers to add or drop pads:"
        android:textColor="#A7A7B8"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tgl1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#2C2C3E"
            android:padding="10dp"
            android:text="1"
            android:textColor="#F2F2F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tgl2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#2C2C3E"
            android:padding="10dp"
            android:text="2"
            android:textColor="#F2F2F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tgl3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#2C2C3E"
            android:padding="10dp"
            android:text="3"
            android:textColor="#F2F2F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tgl4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#2C2C3E"
            android:padding="10dp"
            android:text="4"
            android:textColor="#F2F2F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tgl5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#2C2C3E"
            android:padding="10dp"
            android:text="5"
            android:textColor="#F2F2F7"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tgl6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#2C2C3E"
            android:padding="10dp"
            android:text="6"
            android:textColor="#F2F2F7"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/soundsBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:backgroundTint="#2C2C3E"
            android:padding="12dp"
            android:text="♪ Sounds…"
            android:textColor="#F2F2F7"
            android:textSize="15sp" />

        <Button
            android:id="@+id/humBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:backgroundTint="#2C2C3E"
            android:padding="12dp"
            android:text="🎤 Hum → instrument…"
            android:textColor="#F2F2F7"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/exportBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#2C2C3E"
        android:padding="12dp"
        android:text="⇪  Export loop as a WAV gift…"
        android:textColor="#F2F2F7"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Tap a pad to record · tap again to loop it · tap a playing pad to stop it · hold a pad to clear it · Sounds, Hum and Export act on the last pad you tapped"
        android:textColor="#A7A7B8"
        android:textSize="12sp" />
</LinearLayout>
